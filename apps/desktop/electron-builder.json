{
  "electronVersion": "39.8.8",
  "appId": "com.dadei.app",
  "productName": "chello",
  "copyright": "Copyright © 2026 Ankur Desai",
  "artifactName": "chello-${version}-${os}-${arch}.${ext}",
  "afterSign": "scripts/notarize.cjs",
  "files": [
    "dist/**/*",
    "renderer/dist/**/*",
    "package.json",
    ".env.production"
  ],
  "directories": {
    "buildResources": "resources",
    "output": "release"
  },
  "extraResources": [
    {
      "from": "resources/logo.png",
      "to": "logo.png"
    },
    {
      "from": "resources/logo-transparent.png",
      "to": "logo-transparent.png"
    }
  ],
  "asar": true,
  "asarUnpack": [
    "**/node_modules/easy-volume/**/volume.exe"
  ],
  "publish": {
    "provider": "github",
    "owner": "chello-app",
    "repo": "frontend"
  },
  "win": {
    "target": "nsis",
    "icon": "resources/icon.ico"
  },
  "nsis": {
    "differentialPackage": false
  },
  "mac": {
    "target": ["dmg", "zip"],
    "icon": "resources/icon.icns",
    "hardenedRuntime": true,
    "gatekeeperAssess": false,
    "entitlements": "resources/entitlements.mac.plist",
    "entitlementsInherit": "resources/entitlements.mac.inherit.plist",
    "extendInfo": {
      "NSLocationWhenInUseUsageDescription": "chello uses your location for timezone and local assistant context.",
      "NSMicrophoneUsageDescription": "chello uses the microphone for voice commands and wake word.",
      "NSScreenCaptureUsageDescription": "chello captures the screen when you ask for screenshots or window context."
    }
  },
  "linux": {
    "target": ["AppImage"],
    "icon": "resources/logo.png",
    "category": "Utility"
  },
  "protocols": [
    {
      "name": "Chello OAuth",
      "schemes": ["chello"]
    }
  ]
}
